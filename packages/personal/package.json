{
  "name": "@xrunmasterx/dsh-personal",
  "description": "Opt-in personal workbench composition layered over the official Web profile",
  "version": "0.1.0",
  "private": true,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xrunmasterx/dsh-personal.git",
    "directory": "packages/personal"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "cordis.patch.yml",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "dependencies": {
    "@xrunmasterx/dsh-personal-host": "workspace:*",
    "@xrunmasterx/dsh-personal-api": "workspace:*",
    "@xrunmasterx/dsh-personal-client": "workspace:*"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "4.0.2"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.2"
  }
}
