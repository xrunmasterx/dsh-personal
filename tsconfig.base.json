{
  "compilerOptions": {
    "target": "ES2024",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "declaration": true,
    "composite": true,
    "incremental": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowImportingTsExtensions": true,
    "rewriteRelativeImportExtensions": true,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "types": [
      "node"
    ],
    "paths": {
      "@xrunmasterx/dsh-personal": [
        "./packages/personal/src/index.ts"
      ],
      "@xrunmasterx/dsh-personal-host": [
        "./packages/host/src/index.ts"
      ],
      "@xrunmasterx/dsh-personal-host/client": [
        "./packages/host/src/client.ts"
      ],
      "@xrunmasterx/dsh-personal-api": [
        "./packages/api/src/index.ts"
      ],
      "@xrunmasterx/dsh-personal-api/client": [
        "./packages/api/src/client/index.ts"
      ],
      "@xrunmasterx/dsh-personal-client": [
        "./packages/client/src/index.ts"
      ],
      "@xrunmasterx/dsh-personal-client/client": [
        "./packages/client/src/client/index.ts"
      ]
    }
  }
}
